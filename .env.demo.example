# Copy to .env.demo.local (git-ignored) and fill in. Used only by scripts/demo/*.
# With a local Supabase (supabase start) the URL and keys are read automatically, so only the password is needed.

# Password for the three demo sign-ins (at least 12 characters). Pick your own.
DEMO_USER_PASSWORD=

# Only if you use a separate HOSTED demo project instead of the local one:
# DEMO_SUPABASE_URL=https://<demo-project-ref>.supabase.co
# DEMO_SUPABASE_ANON_KEY=
# DEMO_SUPABASE_SERVICE_ROLE_KEY=
# DEMO_PROJECT_REF=<demo-project-ref>
# DEMO_ALLOW_REMOTE=yes
